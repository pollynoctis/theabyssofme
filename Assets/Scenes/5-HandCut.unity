  m_Name: 
  m_EditorClassIdentifier: 
  steps:
  - sentence: Cut what once held purpose. It no longer remembers why.
    correctPoint: {fileID: 15795323}
  - sentence: Cut in the hollow where nothing is asked, and nothing answers.
    correctPoint: {fileID: 420908512}
  - sentence: Cut in the smallest part, long abandoned by intention or care.
    correctPoint: {fileID: 1994993279}
  - sentence: Cut along the path that leads nowhere and never did.
    correctPoint: {fileID: 1070882600}
  - sentence: Cut where defiance stood, now collapsed into quiet surrender.
    correctPoint: {fileID: 302033157}
  - sentence: Cut where promises waited too long and rotted.
    correctPoint: {fileID: 1456111701}
  sentenceText: {fileID: 51221149}
