--- !u!114 &1825612152
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1825612150}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 026b968433a6ae74aa47e1701b4b7b73, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textLines:
  - 'Executioner: You''re not sick. You''re just tired. You''re too sensitive. You
    need to walk more. You need to eat. You need to sleep. You need to stop lying.'
  - 'Executioner: But here''s one little truth. You actually are a little bit sick.
    But not in the way you want. Not in a beautiful, fragile, tender way. You''re
    sick in a dirty way. With rot. Your blood has congealed, your organs aren''t
    working, and something is growing in your lungs.

'
  - 'Executioner: Do you feel how your skin is losing its integrity? How something
    is crawling under it?

'
  - 'Executioner: Or maybe... maybe there''s something living inside you?

'
  - 'Executioner: Oh, you feel it, right? How it moves? How it bites? How it grows
    at your expense?

'
  - 'Executioner: Congrats. I have good news for you.

'
  - 'pause

'
  - 'Executioner: But you are disgusted, aren''t you? You don''t want to feel it.
    You want to pull it out.

'
  - 'pause, make milly shake

'
  - "Executioner: No, no. Not now. Let\u2019s check you first.\r\n"
  textDuration: -1
  isHint: 0
