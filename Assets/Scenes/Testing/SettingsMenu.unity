--- !u!114 &1339245719411826746
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1019386330521057200}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 026b968433a6ae74aa47e1701b4b7b73, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textLines:
  - 'Executioner: You never left the house. But here you are. '
  - 'Executioner: Do you remember how it started?'
  - 'Milly: ...

'
  - 'Executioner: Did he come into the room?'
  - 'Executioner: Or did you come yourself?'
  - 'Executioner: You came yourself, didn''t you?

'
  - 'Executioner: You were just waiting there. Just waiting.

'
  - "Executioner: The funniest part is that he doesn\u2019t remember you.\r"
  - "Executioner: You writhe so much, you shake so much, you think it tore you to
    pieces.\n\r"
  - 'Executioner: And he... doesn''t even remember.'
  - 'Executioner: You''re just another place he''s been in.

'
  textDuration: 5
  isHint: 0
